+      { id: "grain", x: 0, y: 0, terrain: "grain", number: 6, vertexIds: ["home"] },
+      { id: "wool", x: 0, y: 0, terrain: "wool", number: 2, vertexIds: ["site"] },
+    ],
+    ports: [],
+  };
+  return state;
+}
