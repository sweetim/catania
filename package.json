{
  "name": "catania",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "mobile:bundle": "bun run scripts/build-mobile-bundle.ts",
    "mobile:build:ios": "bun run mobile:bundle && cd mobile && eas build --platform ios --profile production",
    "mobile:build:ios:simulator": "bun run mobile:bundle && cd mobile && eas build --platform ios --profile simulator",
    "mobile:build:android": "bun run mobile:bundle && cd mobile && eas build --platform android --profile production",
    "mobile:submit:ios": "cd mobile && eas submit --platform ios --latest",
    "mobile:submit:android": "cd mobile && eas submit --platform android --latest",
    "typecheck": "tsgo --noEmit",
    "test": "bun test tests/game",
    "test:browser": "playwright test",
    "test:browser:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:browser:robber": "playwright test --config playwright.robber.config.ts"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "jsqr": "^1.4.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "ts-pattern": "^5.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "peer": "^1.0.2",
    "peerjs-js-binarypack": "^2.1.0",
    "typescript": "^7.0.2"
  }
}
